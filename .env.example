# Referencia de variables de entorno. Copia a `.env` solo si tu herramienta lo carga;
# `sbt run` NO lee este archivo: exporta las variables en la terminal o defínelas en Render.
# `.env` está en .gitignore: nunca se versiona. Aquí solo van valores de ejemplo, sin secretos.

# Interfaz de escucha. 127.0.0.1 en local; la imagen Docker ya usa 0.0.0.0.
HOST=127.0.0.1

# Puerto. Render lo inyecta solo: no lo definas allí.
PORT=8484

# Orígenes permitidos por CORS: UNA SOLA CADENA de texto, no un arreglo.
# Un origen:    CORS_ALLOWED_ORIGINS=https://eurofibo.netlify.app
# Varios:       separados por coma, sin corchetes ni comillas ni espacios obligatorios:
#               CORS_ALLOWED_ORIGINS=https://eurofibo.netlify.app,http://localhost:5173
# Reglas: con https:// o http://, sin barra final, sin comodín (*). Vacío = solo mismo origen.
CORS_ALLOWED_ORIGINS=
